# Example environment variables for local development.
# Copy this to .env and fill in real values. Do NOT commit .env.

# OpenAI
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4o

# Blog to scrape (homepage)
BLOG_URL=https://example-blog.example.com

# Email / Mailgun (same variables used by run_prompt.py)
EMAIL_SENDER=your-email@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_RECIPIENT=your-recipient@example.com
MAILGUN_API_KEY=your-mailgun-key

# Optional: output path
#OUTPUT_DIR=outputs
